# Copy to .env and fill in values before running docker compose.
# .env is git-ignored; this file is the shape reference only.

# ── Jenkins ────────────────────────────────────────────────────────────────────
# Admin password used by JCasC and the Jenkins UI.
JENKINS_ADMIN_PASSWORD=change-me

# cosign signing key passphrase (keep the private key out of git).
COSIGN_PASSWORD=

# ── Registry ───────────────────────────────────────────────────────────────────
# Address of the local Docker registry reachable by the LXC hosts.
# Example: workstation.lan.example:5000
REGISTRY_HOST=workstation.lan.example:5000

# ── Lab host IPs (set to match your LAN) ──────────────────────────────────────
# These are used by scripts/verify.sh, scripts/flip-weights.sh,
# and the stage4 Prometheus / HAProxy configs.
LEGACY_HOST=legacy-app.lab.example      # CT legacy-app (Jetty 9.4 WAR)
CONTAINER_HOST=container-app.lab.example # CT container-app (containerized)
LB_HOST=lb.lab.example                  # CT lb (HAProxy)
MONITOR_HOST=monitor.lab.example        # CT monitor (Prometheus + Grafana)
DB_HOST=db.lab.example                  # CT db (MySQL 8)
LOG_INDEXER_HOST=log-indexer.lab.example # CT log-indexer (Splunk)
HYPERVISOR_HOST=hypervisor.lab.example  # Proxmox hypervisor
GATEWAY_IP=10.0.0.1                     # LAN gateway (used by lxc-setup.sh for --gw)
WORKSTATION_HOST=workstation.lan.example # Your workstation (runs docker compose)

# ── LXC CT IDs (Proxmox) ──────────────────────────────────────────────────────
# Used by scripts/proxmox-example/lxc-setup.sh and lxc-teardown.sh.
# Pick IDs that do not conflict with existing containers on your hypervisor.
CT_LEGACY=730         # example; replace with your LXC CT ID
CT_CONTAINER=731      # example
CT_LB=732             # example
CT_MONITOR=733        # example
CT_DB=734             # example
CT_LOG_INDEXER=735    # example

# ── Splunk ─────────────────────────────────────────────────────────────────────
# Admin password for Splunk Web (stored in admin_password.txt on the log-indexer host,
# never committed; see stage5/splunk/README.md).
# SPLUNK_ADMIN_PASSWORD is not passed to docker compose — set it on the log-indexer host.

# ── Network ─────────────────────────────────────────────────────────────────────
# Subnet used by lxc-setup.sh to detect IP conflicts (e.g. 10.0.0.0/24).
LAB_SUBNET=10.0.0.0/24

# ── Application database ────────────────────────────────────────────────────────
# PetClinic app credentials — set these before running provision-container.sh.
JDBC_USER=petclinic
JDBC_PASSWORD=changeme
# JDBC_URL: replace db.lab.example with your db hostname (variable expansion
# does not work in dotenv files; use a literal host).
JDBC_URL=jdbc:mysql://db.lab.example:3306/petclinic
# JDBC_DRIVER_CLASS: read by stage2/entrypoint.sh and stage4/scripts/provision-container.sh.
JDBC_DRIVER_CLASS=com.mysql.cj.jdbc.Driver
GF_SECURITY_ADMIN_PASSWORD=changeme
